render_dir := "../../web/static/notebooks/questions/edinburgh_heights"

marimo:
    uv run marimo edit

render:
    rm -rf {{render_dir}}/*
    mkdir -p {{render_dir}}
    uv run marimo export html-wasm vis12.py --force --output {{render_dir}}/vis.html
    cp edinburgh.arrow {{render_dir}}
    cp edinburgh_min_10.arrow {{render_dir}}
