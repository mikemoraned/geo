import 'mirror.just'

# List the releases the bucket serves, marking each that a later release of the same date supersedes.
releases:
    cargo run -q --release -- releases

# Copy one release whole into the mirror, resuming a partial copy. Refuses a superseded release.
sync release:
    cargo run -q --release -- sync {{release}} --mirror "{{overture_mirror}}"

# Check a mirrored release against the bucket, copying nothing. The mirror defaults to mirror.just's.
verify release mirror=overture_mirror:
    cargo run -q --release -- verify {{release}} --mirror "{{mirror}}"

# Run the tests.
test:
    cargo nextest run
