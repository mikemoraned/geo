      GB: "OGC:CRS84"
  - name: geometry_projected
    data_type: Binary
    nullable: true
    extension: geoarrow.wkb
    crs:
      DE: "EPSG:25832"
      GB: "EPSG:25830"
  - name: session_id
    data_type: LargeUtf8
    nullable: false
