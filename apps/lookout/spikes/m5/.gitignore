# The ESP-IDF checkout and its toolchains (~4.3G), shared by every spike here via
# `ESP_IDF_TOOLS_INSTALL_DIR = "custom:../.embuild/espressif"`. Recreated on first build.
/.embuild

# Build output of every crate under here, at whatever depth — spikes that split into
# core/shell crates nest one level deeper than the per-spike .gitignore files reach.
target/
