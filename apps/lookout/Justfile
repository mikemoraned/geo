git_hash := `printf '%s%s' "$(git rev-parse --short HEAD 2>/dev/null)" "$(git diff --quiet 2>/dev/null || echo -dirty)"`

# Install the tools every other recipe needs. See README.md for what each is for.
prerequisites:
    cd {{ justfile_directory() }}/../.. && just prerequisites
    cargo install rerun-cli --locked
    cargo install wasm-pack --locked
    rustup target add wasm32-unknown-unknown
    brew install duckdb proj jq

# Report every pinned version with a newer release: crates, uv projects, SedonaDB, and the ESP toolchain.
outdated:
    #!/usr/bin/env bash
    set -euo pipefail
    newest_release() {
        git ls-remote --tags --refs "$1" | sed 's#.*refs/tags/##' | grep -E "^$2[0-9.]+$" | sort -V | tail -1
    }
    for dir in . {{m5plus_dir}}; do
        echo "## crates in $dir"
        (cd "$dir" && cargo upgrade --dry-run --incompatible --pinned 2>&1 | grep -v '^    Checking')
    done
    find . \( -name target -o -name .venv \) -prune -o -name pyproject.toml -print | sort |
        while read -r pyproject; do
            echo "## uv project $(dirname "$pyproject")"
            uv tree --quiet --directory "$(dirname "$pyproject")" --outdated --depth 1 | grep 'latest:' || echo "up to date"
        done
    echo "## SedonaDB"
    echo "pinned: $(grep -o 'apache-sedona-db-[0-9.]*"' Cargo.toml | head -1 | tr -d '"')"
    echo "newest: $(newest_release https://github.com/apache/sedona-db apache-sedona-db-)"
    echo "## ESP toolchain"
    channel=$(sed -n 's/^channel = "\(.*\)"/\1/p' {{m5plus_dir}}/rust-toolchain.toml)
    echo "pinned: $channel, $(rustc +"$channel" --version)"
    echo "newest: $(newest_release https://github.com/esp-rs/rust-build v)"

# Regenerate the PROJJSON CRS definitions medallion embeds and commits; nothing else emits them.
crs-definitions:
    projinfo -o PROJJSON -q "OGC:CRS84" | jq . > crates/medallion/src/crs84.projjson.json
    projinfo -o PROJJSON -q "EPSG:25832" | jq . > crates/medallion/src/etrs89_utm32n.projjson.json
    projinfo -o PROJJSON -q "EPSG:25830" | jq . > crates/medallion/src/etrs89_utm30n.projjson.json

# Serve on http://localhost:3000 (override with PORT). No redis, so samples are logged, not queued.
serve:
    BUILD_GIT_HASH={{git_hash}} cargo run -p server

# As `serve`, with the redis URL from 1Password, so samples are queued.
serve-redis:
    BUILD_GIT_HASH={{git_hash}} op run --env-file=deploy/lookout.env -- cargo run -p server

# Build the release binary.
build:
    cargo build --release -p server

# Compile the core to wasm, into the dir `server` serves it from.
wasm:
    wasm-pack build crates/platform/web/bridge --target web --out-dir ../../../server/static/wasm --out-name lookout

crossings_version := trim(`cat crossings.version`)

# Copy the crossings a browser fetches into the dir `server` serves them from.
crossings:
    cp "data/medallion/gold/artifact=crossings/version={{crossings_version}}/crossings.json" \
        crates/server/static/crossings.json

sessions_version := trim(`cat sessions.version`)

# Choose the recorded sessions worth replaying into gold, and adopt what was written.
gold-pack-sessions *args:
    cargo run --release -p session_crossings --bin pack_sessions -- \
        --version-file sessions.version --min-crossings 5 --max-sessions 3 {{args}}

# Copy the sessions a kiosk replays into the dir `server` serves them from.
kiosk-sessions:
    cp "data/medallion/gold/artifact=sessions/version={{sessions_version}}/sessions.json" \
        crates/server/static/sessions.json

# Serve on http://localhost:3000 with the wasm and the data freshly copied.
serve-web: wasm crossings kiosk-sessions serve

# Every test: the Rust workspace, Docker ones included, and the Python ones.
test: test-python test-rust

# Every Rust test, doctests included.
test-rust: test-doc
    cargo nextest run --workspace

# Every test but the Docker ones. The sandbox-safe run.
test-no-docker: test-python test-doc
    cargo nextest run --workspace --profile no-docker

# The geo tests: the crossings the store holds, against the bbox test cases. Needs a filled store.
test-geo:
    cargo nextest run --profile geo

# The doctests alone. nextest cannot run them, so cargo does.
test-doc:
    cargo test --doc --workspace

# The Python tests, rebuilding both extensions so a change to the rust crates reaches them.
test-python:
    uv run --directory crates/medallion-py --reinstall-package lookout-medallion pytest -q
    uv run --directory crates/platform/rerun-py --reinstall-package lookout-predictor --reinstall-package lookout-medallion pytest -q
    uv run --directory notebooks/water_crossings pytest -q

# Tests against real services, in release, with credentials from 1Password. Hits the real redis.
end_to_end_test:
    op run --env-file=deploy/lookout.env -- cargo nextest run --release --workspace --profile end-to-end

# Deploy the server to fly.io (lookout.fly.dev), with the git hash and the crossings baked in.
deploy:
    fly deploy --build-arg BUILD_GIT_HASH="{{git_hash}}" \
        --build-arg CROSSINGS_VERSION="{{crossings_version}}" \
        --build-arg SESSIONS_VERSION="{{sessions_version}}"

# Set up a fresh worktree's store from what the checkout carries. Gold waits until needed.
init: bronze-init silver-init

overture_mirror := "/Volumes/PRO-G40/OvertureMaps/data/release"

# Fill in the bronze a checkout leaves out: every recorded Overture extract, from a mirror if mounted.
bronze-init *args:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -d "{{overture_mirror}}" ]; then
        echo "reading the Overture mirror at {{overture_mirror}}"
        just bronze-extract --mirror "{{overture_mirror}}" {{args}}
    else
        echo "no Overture mirror at {{overture_mirror}}; reading the public bucket"
        just bronze-extract {{args}}
    fi

# Report what the store holds, layer by layer.
summarise *args:
    cargo run -q -p summary --bin summarise -- {{args}}

# Read the telemetry queue into bronze, with the redis URL from 1Password.
bronze-record *args:
    op run --env-file=deploy/lookout.env -- cargo run -p recorder --bin recorder -- {{args}}

# Poll Motis for trips near recent GPS into bronze, redis URL from 1Password. Runs until stopped.
bronze-poll-motis *args:
    BUILD_GIT_HASH={{git_hash}} op run --env-file=deploy/lookout.env -- cargo run -p motis --bin motis_poll -- --feed local {{args}}

# Fetch the API spec of the Motis version tools/motis-server pins; the motis client is generated from it.
motis-openapi:
    version=$(just --justfile ../../tools/motis-server/Justfile --evaluate VERSION) && curl -fsSL "https://raw.githubusercontent.com/motis-project/motis/$version/openapi.yaml" | yq -o=json '.' > crates/motis/openapi.json

# Take an Overture extract into bronze. No args fills in every recorded one; `new` takes a fresh one.
bronze-extract *args:
    cargo run --release -p transport --bin extract -- {{args}}

# Re-derive every silver dataset from bronze, in order. Safe to re-run; needs `bronze-init` first.
silver-init *args:
    just silver-sessionise {{args}}
    just silver-motis-ingest {{args}}
    just silver-crossings {{args}}

# Derive silver `train_segment` from the bronze motis capture log.
silver-motis-ingest *args:
    cargo run -p motis --bin motis_ingest -- {{args}}

# Derive silver `session` and `session_sample` from the bronze telemetry.
silver-sessionise *args:
    cargo run --release -p recorder --bin sessionise -- {{args}}

# Derive both crossing datasets. The water half is the slow one; args reach the session half only.
silver-crossings *args:
    just silver-water-crossings
    just silver-session-crossings {{args}}

# Derive silver `water_crossing` from the crossings notebook. Always writes the repo store.
silver-water-crossings:
    uv run --no-project --reinstall-package lookout-medallion notebooks/water_crossings/v10.py

# Check the water crossings the store holds against the bbox test cases. Reads; derives nothing.
crossing-checks:
    uv run --no-project --reinstall-package lookout-medallion \
        notebooks/water_crossings/check_cases.py

# Derive silver `session_crossing`: the crossings each recorded session passed.
silver-session-crossings *args:
    cargo run --release -p session_crossings --bin match_crossings -- {{args}}

# Pack the silver water crossings into gold, and adopt the version written.
gold-pack-crossings *args:
    cargo run -p crossings --bin pack_crossings -- --version-file crossings.version {{args}}

export LIBCLANG_PATH := `ls -d "$HOME"/.rustup/toolchains/esp-1.98.1.0/xtensa-esp32-elf-clang/*/esp-clang/lib 2>/dev/null | tail -1`

m5plus_dir := "crates/platform/m5/m5plus"

# Build the device shell. The first run installs ESP-IDF, which takes hours.
m5plus-build:
    cd {{m5plus_dir}} && cargo build

# The same, in release: 1.7x faster over the crossing scan.
m5plus-build-release:
    cd {{m5plus_dir}} && cargo build --release

# Flash the device and tail its console. Ctrl-C leaves the monitor.
m5plus-flash: m5plus-build
    cd {{m5plus_dir}} && espflash flash --monitor target/xtensa-esp32-espidf/debug/m5plus

# The same, from the release build.
m5plus-flash-release: m5plus-build-release
    cd {{m5plus_dir}} && espflash flash --monitor target/xtensa-esp32-espidf/release/m5plus

# Tail the console of what is already flashed, leaving it running. Leave with ctrl-A then K.
m5plus-monitor port=`ls /dev/cu.usbserial-* 2>/dev/null | head -1`:
    screen {{port}} 115200

# The sessions the store holds, as `just replay` names them.
sessions *args:
    uv run --directory crates/platform/rerun-py python -m runner.main sessions {{args}}

# Replay a session through the predictor, into a rerun viewer already running — start one with `rerun`.
replay session *args:
    uv run --directory crates/platform/rerun-py python -m runner.main replay {{session}} {{args}}

# Push the redis URL to fly from 1Password.
push-secrets:
    fly secrets set LOOKOUT_REDIS_URL="$(op read 'op://Dev/lookout-upstash-redis-url/password')"
