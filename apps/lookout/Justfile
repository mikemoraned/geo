# Lookout app recipes. Run from `apps/lookout`.

# Short git hash of the working tree, with a -dirty suffix if uncommitted. Baked
# into the binary (BUILD_GIT_HASH) so it's logged at startup and served at /version.
git_hash := `printf '%s%s' "$(git rev-parse --short HEAD 2>/dev/null)" "$(git diff --quiet 2>/dev/null || echo -dirty)"`

prerequisites:
    cargo install rerun-cli --locked

# Run the server locally on http://localhost:3000 (override with PORT).
# Log-only: LOOKOUT_REDIS_URL is unset, so received samples are logged, not queued.
serve:
    BUILD_GIT_HASH={{git_hash}} cargo run -p server

# Run the server locally with the upstash redis URL resolved from 1Password, so
# received samples are LPUSHed onto the lookout-telemetry queue.
serve-redis:
    BUILD_GIT_HASH={{git_hash}} op run --env-file=deploy/lookout.env -- cargo run -p server

# Build the release binary.
build:
    cargo build --release -p server

# Run all tests: the Rust workspace (incl _docker tests — requires Docker) and the
# Python visualise tests.
test: test-python
    cargo nextest run --workspace

# Run tests without Docker: the no-docker profile skips _docker-named tests. Still
# runs the Python visualise tests (they need no Docker).
test-no-docker: test-python
    cargo nextest run --workspace --profile no-docker

# Run the Python visualise tests.
test-python:
    uv run --directory visualise pytest -q

# Run the end_to_end tests against real services (release mode), with real
# credentials injected from 1Password. Hits the real upstash redis.
end_to_end_test:
    op run --env-file=deploy/lookout.env -- cargo nextest run --release --workspace --profile end-to-end

# Deploy the server to fly.io (lookout.fly.dev), using ./fly.toml + ./Dockerfile.
# Bakes the git hash into the build so /version and startup logs identify the deploy.
deploy:
    fly deploy --build-arg BUILD_GIT_HASH="{{git_hash}}"

# Read the upstash telemetry queue into a SQLite archive, with the redis URL from
# 1Password. No args = non-destructive view-latest; `just record drain` to drain.
record *args:
    op run --env-file=deploy/lookout.env -- cargo run -p recorder -- {{args}}

# Enrich the SQLite archive with Overture transport data: group the `gps` fixes into
# per-device-day bounding boxes, fetch the rail segments + connectors intersecting them
# from public Overture Maps S3 (anonymous — no credentials), and write a `transport`
# table. No args = defaults (data/lookout.sqlite, pinned release); override with --db /
# --release. Idempotent, so re-running won't duplicate rows.
enrich *args:
    cargo run -p transport --bin enrich -- {{args}}

# Convert the SQLite archive into a rerun .rrd, selecting by time window (and
# optionally device id prefixes). Requires --since, e.g. `just visualise --since 7d`
# or `just visualise --since 12h --devices 77a cdf2`. Open the .rrd with `rerun`, or
# pass `--open` to push it live to a running viewer (overriding its persisted layout).
visualise *args:
    uv run --project visualise python visualise/main.py {{args}}

# Push the upstash redis URL secret to fly from 1Password.
push-secrets:
    fly secrets set LOOKOUT_REDIS_URL="$(op read 'op://Dev/lookout-upstash-redis-url/password')"
